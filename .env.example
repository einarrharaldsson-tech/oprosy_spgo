DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oprosy
DB_PASSWORD=your_password
DB_NAME=oprosy

# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string

PORT=3000

# development | production
NODE_ENV=development

# Dev: URL Vite. В production — полный URL приложения
CLIENT_URL=http://localhost:5173

# Пусто = корень сайта. Подкаталог, если нужно: /oprosy
BASE_PATH=

# Максимальный размер аудиозаписи одного проведения (МБ)
MAX_AUDIO_MB=50

# DaData Suggestions API (подсказки адресов). Секретный ключ не нужен.
DADATA_API_KEY=
